# 服务器配置
NODE_ENV=development
PORT=3000

# 数据库配置
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/ai_resume_optimizer?schema=public&connection_limit=10"

# JWT 配置
JWT_SECRET=generate-with: openssl rand -hex 64
JWT_REFRESH_SECRET=generate-with: openssl rand -hex 64
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# IP 封禁配置
IP_BLOCK_THRESHOLD=10
IP_BLOCK_DURATION=3600000

# CORS 配置（逗号分隔多个来源）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# 日志配置
LOG_LEVEL=info

# 调试密钥（生产环境留空，仅开发环境配合 x-debug 请求头使用）
DEBUG_KEY=

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# AI API 配置 (Agnes-2.0-Flash)
AI_API_KEY=your-ai-api-key-here
AI_MODEL=Agnes-2.0-Flash
AI_BASE_URL=https://api.agnes.ai/v1
